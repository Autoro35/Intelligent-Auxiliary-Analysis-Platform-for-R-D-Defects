# ============================================================
# docker compose 环境变量样例
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 gitignore，不要提交真实密钥
# ============================================================

# ---- 对外端口 ----
# 注意：以下端口刻意避开本机默认端口，防止与本地已装的 MySQL/Redis 冲突
FRONTEND_PORT=8888
BACKEND_PORT=8081
MYSQL_PORT=3307
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673

# ---- 数据库 ----
DB_NAME=defect_platform
MYSQL_ROOT_PASSWORD=123456

# ---- 初始化管理员（首次启动自动创建）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- JWT（生产环境务必更换，长度需 >= 32 字节）----
JWT_SECRET=defect-platform-jwt-secret-key-please-change-in-prod-0123456789

# ---- RabbitMQ ----
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest

# ---- AI 能力（留空则自动降级为本地规则引擎，功能仍可用）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Chroma 向量库（未部署时 RAG 自动降级为 MySQL 全文索引）----
# host.docker.internal 指向宿主机，即 Chroma 跑在宿主机上的场景
CHROMA_HOST=host.docker.internal
CHROMA_PORT=8000
